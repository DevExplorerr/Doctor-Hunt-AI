# Doctor Hunt AI — environment configuration template.
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to version control.

# Required — Alibaba Cloud Model Studio
# API key for the Model Studio account (server-side only; never ship in clients).
ALIBABA_API_KEY=your_alibaba_api_key

# Required — OpenAI-compatible chat completions endpoint URL
# (e.g. https://<your-endpoint>.<region>.maas.aliyuncs.com/compatible-mode/v1/chat/completions)
ALIBABA_ENDPOINT=https://your-model-studio-endpoint.example.com/compatible-mode/v1/chat/completions

# Optional — model configuration (defaults shown)
ALIBABA_MODEL=qwen-plus
ALIBABA_VISION_MODEL=qwen-vl-plus
ALIBABA_JSON_MODE=true

# Optional — server port (default 3000; injected automatically by Render)
PORT=3000
